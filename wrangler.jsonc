/**
 * Cloudflare Workers configuration for Fin
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "notion-avatar",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",

	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],

	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},

	"ai": {
		"binding": "AI"
	},

	"kv_namespaces": [
		{
			"binding": "FIN_MEMORY",
			"id": "USER_NOTIFICATION"
		}
	],

	"vars": {
		"ENABLE_DIAGNOSTICS": "false"
	},

	"observability": {
		"enabled": true
	},

	"secrets": {
		"required": [
			"NOTION_TOKEN"
		]
	},

	"upload_source_maps": true
}
